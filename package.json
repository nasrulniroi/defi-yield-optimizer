{
  "name": "defi-yield-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "DeFi Yield Optimizer - Auto-compound yields across Aave, Compound, Yearn, Convex",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "db:migrate": "psql -f sql/migrations/001_init.sql",
    "db:seed": "psql -f sql/seeds/001_protocols.sql",
    "scanner:build": "cd scripts/go && go build -o ../../bin/scanner",
    "scanner:run": "./bin/scanner",
    "analyze": "cd scripts/python && python3 yield_analyzer.py",
    "prepare": "husky install"
  },
  "dependencies": {
    "next": "14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "chart.js": "^4.4.1",
    "react-chartjs-2": "^5.2.0",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "@heroicons/react": "^2.1.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "ethers": "^6.10.0",
    "swr": "^2.2.4",
    "zustand": "^4.5.0",
    "framer-motion": "^11.0.3",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.12.0",
    "numeral": "^2.0.6",
    "lodash": "^4.17.21",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/react": "^18.2.48",
    "@types/node": "^20.11.10",
    "@types/lodash": "^4.14.202",
    "@types/numeral": "^2.0.5",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "prettier": "^3.2.4",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.2.0",
    "husky": "^9.0.6",
    "lint-staged": "^15.2.0"
  }
}
