{
  "name": "defi-yield-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "DeFi Yield Optimizer - Auto-compound yields across Aave, Compound, Yearn, Convex",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "db:migrate": "psql -f sql/migrations/001_init.sql",
    "db:seed": "psql -f sql/seeds/001_protocols.sql",
    "scanner:build": "cd scripts/go && go build -o ../../bin/scanner",
    "scanner:run": "./bin/scanner",
    "analyze": "cd scripts/python && python3 yield_analyzer.py"
  },
  "dependencies": {
    "next": "14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "chart.js": "^4.4.1",
    "react-chartjs-2": "^5.2.0",
    "clsx": "^2.1.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/react": "^18.2.48",
    "@types/node": "^20.11.10"
  }
}